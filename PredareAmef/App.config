<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <appSettings>
    <add key="FmiExePath" value="C:\Users\adria\Desktop\FMI.exe" />
    <add key="DefaultOutputRoot" value="" />
    <!-- GitHub Personal Access Token pentru auto-update (read-only pe repo privat).
         Inlocuit la deploy cu token-ul real. Fara token, check-ul esueaza silentios. -->
    <add key="GitHubToken" value="" />
    <add key="AutoCheckUpdate" value="true" />
  </appSettings>
</configuration>
